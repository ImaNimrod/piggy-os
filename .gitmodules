[submodule "printf"]
    path = kernel/src/utils/printf
    url = https://github.com/mpaland/printf.git
    update = merge
[submodule "limine"]
    path = limine
    url = https://github.com/limine-bootloader/limine.git
    branch = v10.x-binary
    update = merge
[submodule "flanterm"]
    path = kernel/src/utils/flanterm
    url = https://codeberg.org/mintsuki/flanterm.git
    update = merge
[submodule "libc"]
    path = libc
    url = https://github.com/ImaNimrod/mlibc.git
    update = merge
[submodule "kernel/src/dev/acpi/uacpi"]
	path = kernel/src/dev/acpi/uacpi
	url = https://github.com/uACPI/uACPI
